<component name="InspectionProjectProfileManager">
  <profile version="1.0">
    <option name="myName" value="Project Default" />
    
    <!-- Enforce camelCase for instance/member variables -->
    <inspection_tool class="InstanceVariableNamingConvention" enabled="true" level="ERROR" enabled_by_default="true">
      <option name="m_regex" value="[a-z][A-Za-z\d]*" />
      <option name="m_minLength" value="1" />
      <option name="m_maxLength" value="32" />
      <scope name="Project Files" level="ERROR" enabled="true" />
    </inspection_tool>

    <!-- Enforce camelCase for local variables (Catches 'Email') -->
    <inspection_tool class="LocalVariableNamingConvention" enabled="true" level="ERROR" enabled_by_default="true">
      <option name="m_ignoreForLoopParameters" value="false" />
      <option name="m_ignoreCatchParameters" value="false" />
      <option name="m_regex" value="[a-z][A-Za-z\d]*" />
      <option name="m_minLength" value="1" />
      <option name="m_maxLength" value="32" />
      <state>
        <option name="DEFAULT_SEVERITY" value="ERROR" />
      </state>
    </inspection_tool>

    <!-- Enforce camelCase for method parameters -->
    <inspection_tool class="ParameterNamingConvention" enabled="true" level="ERROR" enabled_by_default="true">
      <option name="m_regex" value="[a-z][A-Za-z\d]*" />
      <option name="m_minLength" value="1" />
      <option name="m_maxLength" value="32" />
      <state>
        <option name="DEFAULT_SEVERITY" value="ERROR" />
      </state>
    </inspection_tool>

    <!-- Enforce camelCase for instance methods (Catches 'VerificarDatos') -->
    <inspection_tool class="InstanceMethodNamingConvention" enabled="true" level="ERROR" enabled_by_default="true">
      <option name="m_regex" value="[a-z][A-Za-z\d]*" />
      <option name="m_minLength" value="2" />
      <option name="m_maxLength" value="32" />
      <state>
        <option name="DEFAULT_SEVERITY" value="ERROR" />
      </state>
    </inspection_tool>

    <!-- Enforce PascalCase for classes -->
    <inspection_tool class="ClassNamingConvention" enabled="true" level="ERROR" enabled_by_default="true">
      <option name="m_regex" value="[A-Z][A-Za-z\d]*" />
      <option name="m_minLength" value="2" />
      <option name="m_maxLength" value="64" />
      <state>
        <option name="DEFAULT_SEVERITY" value="ERROR" />
      </state>
    </inspection_tool>

  </profile>
</component>