<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MasDatosContacto">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="FORMULARIO DE CONTACTO"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/tvDescripcion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="A continuación, completá los datos adicionales."
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/tvNivelEstudios"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="NIVEL DE ESTUDIOS ALCANZADOS"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvDescripcion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <RadioGroup
        android:id="@+id/rgEstudios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvNivelEstudios"
        app:layout_constraintStart_toStartOf="parent">
        <RadioButton
            android:id="@+id/rbPrimariaIncompleta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primario incompleto"
            android:textSize="16sp" />
        <RadioButton
            android:id="@+id/rbPrimariaCompleta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primario completo"
            android:textSize="16sp" />
        <RadioButton
            android:id="@+id/rbSecundariaIncompleta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secundario incompleto"
            android:textSize="16sp" />
        <RadioButton
            android:id="@+id/rbSecundariaCompleta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secundario completo"
            android:textSize="16sp" />
        <RadioButton
            android:id="@+id/rbOtros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Otros"
            android:textSize="16sp" />
    </RadioGroup>

</androidx.constraintlayout.widget.ConstraintLayout>